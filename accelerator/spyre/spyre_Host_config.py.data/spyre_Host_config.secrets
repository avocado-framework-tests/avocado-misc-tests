# Spyre host-config secrets file
# --------------------------------
# Fill in the values below. This file must NOT be committed to version control.
# It is read at test runtime by _load_secrets() in spyre_Host_config.py and
# takes precedence over any blank value in spyre_Host_config.yaml.
#
# Format: KEY=value  (one per line, no quotes needed around the value)
# Lines starting with # and blank lines are ignored.

# ── Test user ────────────────────────────────────────────────────────────────
USER=
PASSWORD=

# ── Spyre group (can also be set in the YAML) ────────────────────────────────
SPYRE_GROUP=

# ── IBM container registry ───────────────────────────────────────────────────
REGISTRY=
API_KEY=

# ── IBM GSA repository ──────────────────────────────────────────────
GSA_USER=
GSA_PASSWORD=

# ── Red Hat subscription-manager ─────────────────────────────────────────────
REDHAT_USER=
REDHAT_PASSWORD=

# ── HuggingFace ──────────────────────────────────────────────────────────────
HF_TOKEN=

# ── Jfrog  ────────────────────────────────────
JFROG_USERID=
JFROG_TOKEN=
